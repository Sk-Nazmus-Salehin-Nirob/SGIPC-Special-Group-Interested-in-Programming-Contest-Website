@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="page-hero">
    <div class="container">
        <h1 class="page-hero-title">Privacy <span class="gradient-text">Policy</span></h1>
        <p class="page-hero-subtitle">How we handle your information</p>
    </div>
</section>

<section class="privacy-section">
    <div class="container">
        <div class="privacy-card">
            <p class="privacy-date">Last updated: @DateTime.Now.Year</p>

            <h2>Information We Collect</h2>
            <p>
                When you register to join SGIPC KUET, we collect your name, email address,
                and self-reported experience level. This information is used solely to contact
                you about membership and club activities.
            </p>

            <h2>How We Use Your Information</h2>
            <p>
                Your information is used to communicate club news, contest announcements,
                and workshop invitations. We do not sell or share your personal data with
                third parties.
            </p>

            <h2>Data Security</h2>
            <p>
                We take reasonable precautions to protect your information. All data is
                stored securely and access is limited to club administrators.
            </p>

            <h2>Contact</h2>
            <p>
                If you have any questions about this privacy policy, contact us at
                <a href="mailto:sgipc@kuet.ac.bd">sgipc&#64;kuet.ac.bd</a>.
            </p>
        </div>
    </div>
</section>
