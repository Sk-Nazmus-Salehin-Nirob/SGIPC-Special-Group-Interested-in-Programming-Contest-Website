@{
    ViewData["Title"] = "About SGIPC";
}

<section class="page-hero">
    <div class="container">
        <h1 class="page-hero-title">About <span class="gradient-text">SGIPC</span></h1>
        <p class="page-hero-subtitle">Special Group Interested in Programming Contest at KUET</p>
    </div>
</section>

<section class="about-page">
    <div class="container">
        <div class="about-page-grid">
            <div class="about-page-content">
                <h2>Our Mission</h2>
                <p>
                    SGIPC KUET is dedicated to building a community of competitive programmers who
                    excel at solving algorithmic challenges. Founded at Khulna University of Engineering
                    &amp; Technology, we bring together students passionate about problem-solving,
                    mathematics, and computer science.
                </p>

                <h2>Our Vision</h2>
                <p>
                    We aim to nurture world-class competitive programmers from KUET who can compete
                    and succeed at international contests like ICPC, Codeforces, and beyond.
                </p>

                <h2>What We Offer</h2>
                <ul class="about-list">
                    <li>Expert mentorship from senior members and alumni</li>
                    <li>Regular in-house and inter-university contests</li>
                    <li>Weekly workshops on algorithms and data structures</li>
                    <li>A collaborative and supportive community</li>
                    <li>Resources and practice materials for all skill levels</li>
                </ul>
            </div>

            <div class="about-page-side">
                <div class="about-highlight-card">
                    <span class="highlight-icon">🎯</span>
                    <h3>Our Goal</h3>
                    <p>Represent KUET in ICPC and win national and regional titles.</p>
                </div>
                <div class="about-highlight-card">
                    <span class="highlight-icon">🤝</span>
                    <h3>Community First</h3>
                    <p>We grow together — every member's success is SGIPC's success.</p>
                </div>
                <div class="about-highlight-card">
                    <span class="highlight-icon">📈</span>
                    <h3>Continuous Growth</h3>
                    <p>From beginner to expert, we support every stage of your journey.</p>
                </div>
            </div>
        </div>

        <div class="about-cta">
            <a asp-controller="Home" asp-action="Join" class="btn btn-primary">Join SGIPC Today</a>
            <a asp-controller="Home" asp-action="Activities" class="btn btn-outline">See Our Activities</a>
        </div>
    </div>
</section>
