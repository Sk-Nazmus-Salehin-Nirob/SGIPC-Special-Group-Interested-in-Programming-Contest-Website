@{
    ViewData["Title"] = "Contact Us";
}

<section class="page-hero">
    <div class="container">
        <h1 class="page-hero-title">Contact <span class="gradient-text">Us</span></h1>
        <p class="page-hero-subtitle">We'd love to hear from you</p>
    </div>
</section>

<section class="contact-section">
    <div class="container">
        <div class="contact-grid">
            <div class="contact-info">
                <h2>Get in Touch</h2>
                <p>Have questions about SGIPC? Reach out to us and we'll get back to you as soon as possible.</p>

                <div class="contact-item">
                    <span class="contact-icon">📍</span>
                    <div>
                        <strong>Address</strong>
                        <p>KUET, Khulna – 9203, Bangladesh</p>
                    </div>
                </div>
                <div class="contact-item">
                    <span class="contact-icon">✉️</span>
                    <div>
                        <strong>Email</strong>
                        <p>sgipc&#64;kuet.ac.bd</p>
                    </div>
                </div>
                <div class="contact-item">
                    <span class="contact-icon">🌐</span>
                    <div>
                        <strong>Social</strong>
                        <p>Facebook &bull; Codeforces &bull; GitHub</p>
                    </div>
                </div>
            </div>

            <div class="contact-join-cta">
                <div class="cta-card">
                    <span class="cta-icon">🤝</span>
                    <h3>Ready to Join?</h3>
                    <p>Become a member of SGIPC KUET and start your competitive programming journey.</p>
                    <a asp-controller="Home" asp-action="Join" class="btn btn-primary">Join Now</a>
                </div>
            </div>
        </div>
    </div>
</section>
